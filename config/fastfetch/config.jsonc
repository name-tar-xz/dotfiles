{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "hideCursor": true,
    "binaryPrefix": "si",
    "percent": {
      "type": 3
    },
    "separator": " ➜ "
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "\u001b[30m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m     \u001b[97m  \u001b[96m  \u001b[95m  \u001b[94m  \u001b[93m  \u001b[92m  \u001b[91m  \u001b[90m "
    },
    "break",
    {
      "type": "command",
      "text": "grep ^VERSION= /etc/os-release|cut -d'\"' -f2",
      "key": " ",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "\u001b[93m󰻀 " // 
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "󰏖 ",
      "keyColor": "red"
    },
    "break",
    {
      "type": "shell",
      "key": " ", // 
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "\u001b[92m "
      // "keyColor": "bright_green"
    },
    {
      "type": "break"
    },
    {
      "type": "cpu",
      "key": "\u001b[96m󰻠 "
      // "keyColor": "bright_cyan"
    },
    {
      "type": "gpu",
      "key": "\u001b[91m󰘚 "
      // "keyColor": "bright_red"
    },
    {
      "type": "memory",
      "key": "\u001b[95m󰍛 "
      // "keyColor": "bright_magenta"
    },
    {
      "type": "disk",
      "key": "\u001b[94m "
      // "keyColor": "bright_blue"
    },
    {
      "type": "battery",
      "key": "󰁹 ",
      "keyColor": "green"
    },
    "break"
  ]
}
